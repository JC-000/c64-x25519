build/
# Every other build tree is a top-level build-* directory (the naming rule
# stated beside the Makefile's `clean`), matched by pattern so no list drifts.
/build-*/
# Lock a top-level make holds in this tree (Makefile, issue #140).
/.make.lock
__pycache__/
*.pyc
.DS_Store
# Serena: ignore regenerable/local state, track project.yml + memories
.serena/
# Index cache of the retired ca65-ls language server
.ca65-ls/
# Release tarballs produced by tools/build_release.sh / `make dist`
c64-x25519-v*.tar.gz

.bench/
